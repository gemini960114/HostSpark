# Telegram Bot API Token（從 @BotFather 取得）
TELEGRAM_BOT_TOKEN=

# 授權操作的 Telegram 數字 User ID（必填，多個以逗號分隔，亦相容單數 ALLOWED_USER_ID）
ALLOWED_USER_IDS=
# ALLOWED_USER_ID=

# 可選：允許的 Telegram Chat/群組 ID（多個以逗號分隔；留空代表不限制 chat）
ALLOWED_CHAT_IDS=

# 可選：僅允許私訊操作（1=是, 0=否，預設 1）
TELEGRAM_PRIVATE_ONLY=1

# 必填：safe 遵循 AGY 權限規則；full 自動核准所有 AGY 工具操作
AGY_PERMISSION_MODE=safe

# 可選：agy 執行檔；留空時從 PATH 與 ~/.local/bin/agy 尋找
AGY_BIN=

# 可選：AGY 工作目錄；留空時使用使用者 home
AGY_WORKDIR=/home/ubuntu/projects

# 可選：AGY 工作空間根目錄（用於附件儲存與安全路徑隔離，預設與 AGY_WORKDIR 相同）
# 同時也是 /new 專案目錄選擇/建立功能的母目錄
AGY_WORKSPACE_ROOT=/home/ubuntu/projects

# 可選：/new 第一次使用時，預先建立好的預設專案子目錄名稱（預設 initial）
AGY_DEFAULT_PROJECT_DIR=

# 可選：每次執行 AGY 時，附加在使用者請求前方的自訂行為規則
# 建議規範：常駐服務（如 npm run dev、vite、cloudflared、python http.server 等）嚴禁在前景直接執行，一律使用 nohup <cmd> > /tmp/<name>.log 2>&1 & 脫鉤執行以避免終端阻塞
AGY_RULE_PROMPT=

# 可選：Bot 名稱 / 助理名稱（預設：HostSpark）
AGY_BOT_NAME="HostSpark"

# 可選：使用者發送訊息後，Bot 執行時的等待提示訊息
AGY_WAITING_MESSAGE="⏳ HostSpark 正在思考與執行中，請稍候..."

# 可選：進度回報模式（full=完整展開, compact=單行摘要, delete=執行完刪除思考訊息，預設 compact）
AGY_PROGRESS_MODE=compact

# 可選：新訊息進入時自動中斷前次任務並合併 Prompt（1=啟用, 0=停用，預設 1）
AGY_AUTO_INTERRUPT=1

# 可選：允許透過 Telegram /restart 與 /update 自我更新（1=啟用, 0=停用，預設 0）
ALLOW_BOT_UPDATE=0

# 可選：允許切換的模型清單（逗號分隔）。留空時使用內建 fallback 清單，
# 建議先在 VM 上執行 `agy models` 取得真實清單再填入這裡。不帶 -high/-medium/-low
# 後綴的基底名稱（例如 gemini-3.8-flash）會跟 AGY_EFFORT／/effort 選單組合成
# agy 認得的完整模型名稱；已帶後綴的名稱則直接照樣使用。例如：
# "gemini-3.8-flash, gemini-3.7-flash, claude-sonnet-4-6"
AGY_ALLOWED_MODELS=

# 可選：新對話預設使用的模型（需為上面 AGY_ALLOWED_MODELS 或 agy models 清單中的有效值）。
# 留空則不帶 --model 參數，改用 agy CLI 自己的內建預設模型。
AGY_MODEL=

# 可選：新對話預設的推理深度（low|medium|high，預設 high）
AGY_EFFORT=

# 可選：單次 AGY 最長執行秒數（10～3600，預設 600）
AGY_TIMEOUT_SECONDS=600

# 可選：stdout 與 stderr 各自最多保留的 bytes（預設 1000000）
AGY_MAX_OUTPUT_BYTES=1000000

# 定時任務使用的 IANA 時區
AGY_SCHEDULE_TIMEZONE=Asia/Taipei

# 可選：排程 SQLite 路徑；留空時使用 ~/.local/state/agy-telegram-bot/schedules.db
AGY_SCHEDULE_DB_PATH=

# 可選：Chat 狀態 SQLite 路徑；留空時使用 ~/.local/state/agy-telegram-bot/chat_state.db
AGY_STATE_DB_PATH=

# 可選：AGY 歷史對話 SQLite 資料庫路徑（/resume 讀取用）
AGY_CONVERSATION_DB_PATH=

# 排程安全限制（1～1440 分鐘；預設 15）
AGY_SCHEDULE_MIN_INTERVAL_MINUTES=15

# 排程任務上限（1～100；預設 20）
AGY_SCHEDULE_MAX_TASKS=20
