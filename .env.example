# Telegram Bot API Token（從 @BotFather 取得）
TELEGRAM_BOT_TOKEN=

# 唯一允許操作 VM 的 Telegram 數字 User ID（必填，不提供首次自動綁定）
ALLOWED_USER_ID=

# 必填：safe 遵循 AGY 權限規則；full 自動核准所有 AGY 工具操作
AGY_PERMISSION_MODE=

# 可選：agy 執行檔；留空時從 PATH 與 ~/.local/bin/agy 尋找
AGY_BIN=

# 可選：AGY 工作目錄；留空時使用 systemd 服務使用者的 home
AGY_WORKDIR=

# 可選：每次執行 AGY 時，附加在使用者請求前方的自訂行為規則
# 注意：提示詞不是系統層級的安全權限控制
#
# 範例 1－一般 Ubuntu VM 維運：
# AGY_RULE_PROMPT="使用繁體中文回覆。執行任何修改前先說明預計變更；完成後回報執行結果與驗證方式。"
#
# 範例 2－限制專案範圍：
# AGY_RULE_PROMPT="只操作 /home/ubuntu/my-project 目錄。不要讀取或顯示 .env、私鑰、Token、密碼及其他憑證。修改後執行現有測試並摘要結果。"
#
# 範例 3－保守的正式環境維運：
# AGY_RULE_PROMPT="這是正式環境。預設只進行唯讀檢查；不要刪除資料、重啟服務、修改設定、部署或執行資料庫寫入。若任務需要變更，只說明建議步驟與風險，不要直接執行。"
#
# 範例 4－Docker VM：
# AGY_RULE_PROMPT="使用繁體中文回覆。可檢查 Docker 容器、日誌與資源狀態；不要刪除 image、volume、container 或執行 docker system prune。變更容器前先確認目前狀態並保留可回復資訊。"
AGY_RULE_PROMPT=

# 可選：Bot 名稱 / 助理名稱（預設：國網AI助理）
AGY_BOT_NAME="國網AI助理"

# 可選：使用者發送訊息後，Bot 執行時的等待提示訊息（預設：⏳ 國網AI助理 正在思考與執行中，請稍候...）
AGY_WAITING_MESSAGE="⏳ 國網AI助理 正在思考與執行中，請稍候..."

# 可選：單次 AGY 最長執行秒數（10～3600，預設 600）
AGY_TIMEOUT_SECONDS=600

# 可選：stdout 與 stderr 各自最多保留的 bytes（預設 1000000）
AGY_MAX_OUTPUT_BYTES=1000000

# 定時任務使用的 IANA 時區
AGY_SCHEDULE_TIMEZONE=Asia/Taipei

# 可選：排程 SQLite 路徑；留空時使用 ~/.local/state/agy-telegram-bot/schedules.db
AGY_SCHEDULE_DB_PATH=

# 排程安全限制（1～1440 分鐘；預設 15）
AGY_SCHEDULE_MIN_INTERVAL_MINUTES=15

# 可保存的排程數量上限（1～100；預設 20）
AGY_SCHEDULE_MAX_TASKS=20
